// test_stepper_l298n.cpp
#include <Arduino.h>
#include <Stepper.h>
#include "Configuration.h"
#include "BuzzerDriver.h"

// Define steps per revolution for your motor
// NEMA 23 is typically 200 steps/revolution (1.8° per step)
const int STEPS_PER_REVOLUTION = 200;

// L298N control pins (different from your current configuration)
const int STEP1_IN1_PIN = 4;   // L298N pin IN1
const int STEP1_IN2_PIN = 5;   // L298N pin IN2
const int STEP1_IN3_PIN = 6;  // L298N pin IN3
const int STEP1_IN4_PIN = 7;  // L298N pin IN4

// const int STEP2_IN1_PIN = 8;   // L298N pin IN1
// const int STEP2_IN2_PIN = 9;   // L298N pin IN2
// const int STEP2_IN3_PIN = 10;  // L298N pin IN3
// const int STEP2_IN4_PIN = 11;  // L298N pin IN4

// Initialize the stepper library with the L298N pins
Stepper myStepper1(STEPS_PER_REVOLUTION, STEP1_IN1_PIN, STEP1_IN2_PIN, STEP1_IN3_PIN, STEP1_IN4_PIN);
// Stepper myStepper2(STEPS_PER_REVOLUTION, STEP2_IN1_PIN, STEP2_IN2_PIN, STEP2_IN3_PIN, STEP2_IN4_PIN);

// Create buzzer instance
BuzzerDriver buzzer(PIN_BUZZER);

void setup() {
  Serial.begin(9600);
  Serial.println("Stepper Motor Test with L298N");
  Serial.println("-----------------------------");

  // Initialize buzzer
  buzzer.begin();

  // Set motor speed (RPM)
  myStepper1.setSpeed(40);  // 60 RPM (1 revolution per second)
  // myStepper2.setSpeed(40);

  // Confirmation beeps
  buzzer.beep(1000, 100);
  delay(100);
  buzzer.beep(1500, 100);

  Serial.println("Test sequence starting...");
}

void loop() {
  // Rotate one full revolution clockwise
  Serial.println("Rotating clockwise 35 steps");
  myStepper1.step(35);
  buzzer.beep(800, 100);
  delay(1000);
  Serial.println("Rotating anti-clockwise -105 steps");
  myStepper1.step(-105);
  buzzer.beep(800, 100);
  delay(1000);
  Serial.println("Rotating clockwise 105 steps");
  myStepper1.step(105);
  buzzer.beep(800, 100);
  delay(1000);
  Serial.println("Rotating anti-clockwise -105 steps");
  myStepper1.step(-105);
  buzzer.beep(800, 100);
  delay(1000);
  Serial.println("Rotating clockwise 105 steps");
  myStepper1.step(105);
  buzzer.beep(800, 100);
  delay(1000);
  Serial.println("Rotating anti-clockwise -70 steps");
  myStepper1.step(-70);
  buzzer.beep(800, 100);

  // delay(3000);

  // // Rotate one full revolution counter-clockwise
  // Serial.println("Rotating counter-clockwise 1 revolution");
  // myStepper1.step(-STEPS_PER_REVOLUTION);
  // // myStepper2.step(-STEPS_PER_REVOLUTION);
  // buzzer.beep(1000, 100);

  // delay(1000);

  // // Rotate 90 degrees (quarter turn) clockwise
  // Serial.println("Rotating clockwise 1 revolution");
  // myStepper1.step(STEPS_PER_REVOLUTION);
  // // myStepper2.step(STEPS_PER_REVOLUTION/4);
  // buzzer.beep(1200, 100);

  // delay(1000);

  // // Return 90 degrees counter-clockwise
  // Serial.println("Returning counter-clockwise 1 revolution");
  // myStepper1.step(STEPS_PER_REVOLUTION);
  // // myStepper2.step(-STEPS_PER_REVOLUTION/4);
  // buzzer.beep(1200, 100);

  delay(1000);  // Wait 3 seconds before repeating
}
