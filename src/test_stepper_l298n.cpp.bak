// simple_swing_test.cpp
#include <Arduino.h>
#include <Stepper.h>
#include "Configuration.h"
#include "BuzzerDriver.h"

// Motor setup
const int STEPS_PER_REVOLUTION = 200;
Stepper swingMotor(STEPS_PER_REVOLUTION,
                   PIN_SWING_MOTOR_IN1,
                   PIN_SWING_MOTOR_IN2,
                   PIN_SWING_MOTOR_IN3,
                   PIN_SWING_MOTOR_IN4);

BuzzerDriver buzzer(PIN_BUZZER);

void setup() {
  Serial.begin(9600);
  Serial.println("===================");
  Serial.println("SIMPLE SWING TEST");
  Serial.println("===================");
  Serial.println("Testing if motor can move the swing basket");

  buzzer.begin();

  // Start with very slow speed for safety
  swingMotor.setSpeed(40);  // 20 RPM = nice and slow

  buzzer.beep(1000, 200);
  Serial.println("✅ Ready to test in 3 seconds...");
  delay(3000);
}

void loop() {
  Serial.println("\n--- Test Cycle ---");

  // Move swing gently in one direction
  Serial.print("Moving swing right (120 steps)... ");
  swingMotor.step(120);
  Serial.println("✓ Done");
  buzzer.beep(800, 100);

  delay(1000);  // Longer pause between cycles

  Serial.println("Cycle complete. Repeating...");
}
